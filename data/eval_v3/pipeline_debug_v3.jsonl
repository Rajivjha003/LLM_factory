{"id": "pipeline_debug_v3_003", "domain": "pipeline_debugging", "difficulty": "medium", "prompt": "A bronze table has data but silver is empty. What filters should I inspect?", "expected_traits": ["status filters", "null key filters", "date filters"], "must_include": ["filter", "NULL", "COUNT"], "must_not_include": ["DROP TABLE", "DELETE FROM", "TRUNCATE"], "max_score": 3}
