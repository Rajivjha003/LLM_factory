{"id": "pipeline_debug_v3_001", "domain": "pipeline_debugging", "difficulty": "medium", "prompt": "A Dataform incremental table stopped updating after a schema change. What should I inspect?", "expected_traits": ["incremental condition", "schema change", "watermark", "logs"], "must_include": ["incremental", "schema", "watermark"], "must_not_include": ["DROP TABLE", "DELETE FROM", "TRUNCATE"], "max_score": 3}
