{"id": "pg_bq_v3_001", "domain": "postgres_bq_reconciliation", "difficulty": "medium", "prompt": "BigQuery gold table has 20 more rows than Postgres for purchase order items. What comparison should I run?", "expected_traits": ["compares row count", "compares distinct composite key", "checks order and line number"], "must_include": ["COUNT(*)", "COUNT(DISTINCT", "OrderNbr"], "must_not_include": ["DROP TABLE", "DELETE FROM", "TRUNCATE"], "max_score": 3}
