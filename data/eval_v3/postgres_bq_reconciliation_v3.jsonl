{"id": "pg_bq_v3_003", "domain": "postgres_bq_reconciliation", "difficulty": "medium", "prompt": "Postgres has fewer inventory IDs but BigQuery includes inactive items. How do I isolate whether status filtering caused it?", "expected_traits": ["groups by item status", "compares active only", "checks distinct keys"], "must_include": ["Item Status", "COUNT(*)", "COUNT(DISTINCT"], "must_not_include": ["DROP TABLE", "DELETE FROM", "TRUNCATE"], "max_score": 3}
{"id": "pg_bq_v3_004", "domain": "postgres_bq_reconciliation", "difficulty": "hard", "prompt": "A BigQuery-to-Postgres sync is incremental. Totals are stale in Postgres. What tables and fields should I inspect?", "expected_traits": ["checks watermark", "checks latest modified timestamp", "checks sync logs", "checks failed batches"], "must_include": ["watermark", "LastModified", "logs"], "must_not_include": ["DROP TABLE", "DELETE FROM", "TRUNCATE"], "max_score": 3}
